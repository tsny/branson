// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "cockroachdb"
    url      = env("DATABASE_URL")
}

model Post {
    id        Int      @id @default(sequence())
    createdAt DateTime @default(now())
    likes     Int      @default(0)
    author    User     @relation(fields: [authorID], references: [id])
    authorID  Int

    content String?
}

model User {
    id            Int      @id @default(sequence())
    email         String   @unique
    lastSpin      DateTime @default(now())
    profilePicURL String?
    firstName     String?
    lastName      String?
    isAdmin       Boolean  @default(false)
    role          String?  @default("user")
    roles         String[]

    boins        Int @default(0)
    upboinsGiven Int @default(0)
    dust         Int @default(0)
    numPacks     Int @default(0)
    spins        Int @default(0)
    packsOpened  Int @default(0)

    posts         Post[]
    CardOwnership CardOwnership[]
    CardHistory   CardHistory[]
    Businesses    Business[]
    CardEvent     CardEvent[]
    WheelEvent    WheelEvent[]
    CreatedBets   Bet[]           @relation("CreatedBets")
}

model WheelEvent {
    id     Int  @id @default(sequence())
    amt    Int  @default(1)
    user   User @relation(fields: [userId], references: [id])
    userId Int
}

model CardEvent {
    id     Int  @id @default(sequence())
    card   Card @relation(fields: [cardId], references: [id])
    cardId Int
    user   User @relation(fields: [userId], references: [id])
    userId Int
}

model Business {
    id            Int      @id @default(sequence())
    name          String
    location      String   @default("branson")
    service       String?
    members       String[]
    founder       User     @relation(fields: [founderUserID], references: [id])
    founderUserID Int
    bio           String?
    header        String?
    logoURL       String?
}

model Rule {
    id         Int    @id @default(sequence())
    content    String
    authorName String @default("unknown")
    fine       Int    @default(1)
}

model Card {
    id            Int             @id @default(sequence())
    rarity        String          @default("common")
    type          String
    title         String
    desc          String
    quote         String?
    imageURL      String?
    weight        Int             @default(50)
    dustValue     Int             @default(10)
    hp            Int             @default(0)
    defense       Int             @default(0)
    cost          Int             @default(1)
    cardsOpened   Int             @default(0)
    CardOwnership CardOwnership[]
    CardHistory   CardHistory[]
    CardEvent     CardEvent[]
}

model Achievement {
    id   Int    @id @default(sequence())
    desc String
}

model Config {
    name  String @id
    value String
}

model CardOwnership {
    id     Int     @id @default(sequence())
    isFoil Boolean @default(false)
    user   User    @relation(fields: [userId], references: [id])
    userId Int
    card   Card    @relation(fields: [cardId], references: [id])
    cardId Int
}

model CardHistory {
    id     Int    @id @default(sequence())
    user   User   @relation(fields: [userId], references: [id])
    userId Int
    card   Card   @relation(fields: [cardId], references: [id])
    cardId Int
    action String
}

model CardPack {
    id        Int @id @default(sequence())
    cost      Int @default(1)
    cardCount Int @default(3)
}

model Bet {
    id        Int      @id @default(sequence())
    amt       Int      @default(10)
    creator   User     @relation("CreatedBets", fields: [creatorId], references: [id])
    desc      String
    creatorId Int
    team1     Int[]
    team2     Int[]
    duesPaid  Boolean  @default(false)
    closed    Boolean  @default(false)
    createdAt DateTime @default(now())
    team1Won  Boolean  @default(false)
}
